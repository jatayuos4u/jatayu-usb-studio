<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>JatayuOS</vendor>
  <vendor_url>https://jatayuos.in</vendor_url>
  <action id="in.jatayuos.usbstudio.inspect">
    <description>Inspect Jatayu USB Studio preview request</description>
    <message>Allow a read-only USB Studio inspection request?</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>
</policyconfig>
